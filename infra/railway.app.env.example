# Railway app-service variables.
# If your database service is not named "Postgres", replace that namespace below.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}

# Set after generating the app service's public domain.
FRONTEND_ORIGIN=https://${{RAILWAY_PUBLIC_DOMAIN}}

COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# Must be at least 32 bytes. Use a randomly generated secret.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=rehearsal-backend

INITIAL_CLUB_NAME=REPLACE_WITH_CLUB_NAME
INITIAL_ADMIN_LOGIN_ID=REPLACE_WITH_ADMIN_LOGIN_ID
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
INITIAL_ADMIN_NAME=REPLACE_WITH_ADMIN_NAME

NOTIFICATION_SCHEDULER_ENABLED=true
WEB_PUSH_VAPID_PUBLIC_KEY=REPLACE_WITH_EXISTING_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=REPLACE_WITH_EXISTING_VAPID_PRIVATE_KEY
WEB_PUSH_VAPID_SUBJECT=mailto:REPLACE_WITH_CONTACT_EMAIL
